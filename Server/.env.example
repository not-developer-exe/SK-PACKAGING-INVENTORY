# Required
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret>
PORT=5001
NODE_ENV=development

# S.K Packaging GST registration state. GST_STATE_CODE or GSTIN is required before issuing SK invoices.
GST_STATE_CODE=23
# GSTIN=
SK_INVOICE_PREFIX=SK

# NSB Industrial Solutions has an independent GST state and invoice sequence.
# Configure these before issuing NSB invoices.
NSB_GST_STATE_CODE=
# NSB_GSTIN=
NSB_INVOICE_PREFIX=NSB

# Optional GST taxpayer lookup (requires an authorised GST Suvidha Provider account).
# Set the exact endpoint template supplied by your provider; include {gstin} where the GSTIN belongs.
# The endpoint must accept the x-api-key header and return taxpayer fields in GSTN-style JSON.
# Without these values, GSTIN format/state checks work but legal name and address lookup stays unavailable.
GSTIN_LOOKUP_URL_TEMPLATE=
GSTIN_LOOKUP_API_KEY=

# Comma-separated frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Designated ERP accounts. Existing matching accounts are synchronized on API startup.
ADMIN_NAME=Aditya
ACCOUNTANT_NAME=Lakhan
ADMIN_EMAIL=official.additya.singh@gmail.com
ACCOUNTANT_EMAIL=admin@skpackaging.com

# Only needed if the administrator account does not exist yet.
ADMIN_PASSWORD=<use-a-unique-strong-password>
