# Required
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret>
PORT=5001
NODE_ENV=development

# GST registration state. Set the two-digit GST state code (e.g. 23 for Madhya Pradesh),
# or set GSTIN and the first two digits will be used. Required before creating invoices.
GST_STATE_CODE=23
# GSTIN=

# Comma-separated frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Designated ERP accounts. Existing matching accounts are synchronized on API startup.
ADMIN_NAME=Aditya
ACCOUNTANT_NAME=Lakhan
ADMIN_EMAIL=official.additya.singh@gmail.com
ACCOUNTANT_EMAIL=admin@skpackaging.com

# Only needed if the administrator account does not exist yet.
ADMIN_PASSWORD=<use-a-unique-strong-password>
