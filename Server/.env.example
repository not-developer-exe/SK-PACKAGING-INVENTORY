# Required
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret>
PORT=5001
NODE_ENV=development

# Comma-separated frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set ADMIN_EMAIL to your owner login. Existing matching accounts are promoted to admin;
# if the account does not exist, ADMIN_PASSWORD is required to create it.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=official.additya.singh@gmail.com
ADMIN_PASSWORD=<use-a-unique-strong-password>
